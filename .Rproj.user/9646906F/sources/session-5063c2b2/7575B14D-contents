##  FUNCTIONS
# need non-uniform iid estimator and variance function
one_phase_non_uniform <- function(y, w) {
  
  # remove NAs consistently
  keep <- !is.na(y) & !is.na(w)
  y <- y[keep]
  w <- w[keep]
  
  n2 <- length(y)
  if (n2 < 2) stop("Need at least 2 non-missing observations")
  
  # design-based mean
  mu_hat <- weighted.mean(y, w = w)
  
  # average weight
  bar_M2 <- mean(w)
  
  # variance estimator
  var_hat <- (1 / n2) * (1 / (n2 - 1)) *
    sum(((w / bar_M2)^2) * (y - mu_hat)^2)
  
  # return as list
  list(
    mean = mu_hat,
    variance = var_hat,
    se = sqrt(var_hat),
    n = n2
  )
}






