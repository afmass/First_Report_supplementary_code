# define the statistic function for bcajack
stat_fun2 <- function(mat) {
  
  # get response, weights, and design matrix
  y <- mat[, "y"]
  w <- mat[, "w"]
  
  # keep all columns except y and w for predictors
  X <- mat[, setdiff(colnames(mat), c("y","w")), drop = FALSE]
  fire <- X[,"fire"]
  X <- X[,c(-1)]
  
  # fit weighted least squares
  mod <- lm(y ~ X, weights = w)  # add intercept
  
  names(mod$coefficients) <- gsub("X", "", names(mod$coefficients))
  coeff_names <- names(mod$coefficients)
  
  exhaust_vec <- t(exhaustive_mean) %>% 
    as.data.frame %>% 
    mutate(fire = 1) %>%
    select(all_of(coeff_names[-1]))
  
  as.numeric(fire_surface_area_ha*(mod$coefficients %*% c(1,as.numeric(exhaust_vec))))
}

